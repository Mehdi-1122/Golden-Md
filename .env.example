BOT_NAME=Golden MD
BOT_PREFIX=.
OWNER_NUMBER=923001234567

# Pairing code login ke liye bot number yahan likhein; khali = QR code
PAIRING_NUMBER=

# Agar pehle se SESSION_ID hai (pairing site se mila) to yahan daalo —
# bot bina dobara scan kiye khud connect ho jayega. Khali = QR/pairing.
SESSION_ID=

MODE=public
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
# Chatbot ka model. Khali = claude-opus-5-5 (sab se samajhdar, mehnga).
# Sasta: claude-sonnet-5-5 (beech ka) ya claude-haiku-5-5 (bohat sasta)
CHATBOT_MODEL=
# Kitna soch kar jawab de: low (tez, sasta — default) / medium / high
CHATBOT_EFFORT=
# 0 = chatbot internet search na kare
CHATBOT_WEB=

# .gpt .gemini .mistral — key optional hai. Khali ho to free AI chalta hai, woh bhi na chale to Claude.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# .cricket ke liye free key: https://cricketdata.org
CRICKET_API_KEY=

# .removebg ke liye free key: https://www.remove.bg/api
REMOVEBG_API_KEY=

# YouTube (.play .vid .ytmp3 .ytmp4) aur .ig .fb .pin ke liye yt-dlp; PATH par na ho to poora path (misal C:\tools\yt-dlp.exe)
YTDLP=

# Sirf generator server (npm run web) ke liye: tumhari site ka public URL.
# Isse user ko WhatsApp par poori chhoti SESSION_ID bhej di jati hai.
# misal: PUBLIC_URL=https://golden-md.onrender.com
PUBLIC_URL=

# data.json ki jagah (hosting par persistent disk ka path). Khali = ./data.json
DATA_FILE=

# 1 = SESSION_ID terminal/logs mein print ho (default band). Hosting par mat lagao, logs mein poori chaabi chali jati hai.
PRINT_SESSION_ID=

# 1 = har aane wale message ka haal terminal par dikhao (masla dhoondne ke liye)
DEBUG=

STICKER_PACK=Golden MD
STICKER_AUTHOR=Golden MD

# 1 = "Message yourself" mein purane number wale address se bhejo (agar naye LID wale se messages na aayein)
SELF_CHAT_PN=
